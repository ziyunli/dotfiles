# Generic (oh-my-)zsh configuration - sourced by device-specific .zshrc files
# vim: set filetype=zsh:

# If you come from bash you might have to change your $PATH.
# export PATH=$HOME/bin:/usr/local/bin:$PATH

# Path to oh-my-zsh installation
export ZSH="$HOME/.oh-my-zsh"

# Set name of the theme to load --- if set to "random", it will
# load a random theme each time oh-my-zsh is loaded, in which case,
# to know which specific one was loaded, run: echo $RANDOM_THEME
# See https://github.com/robbyrussell/oh-my-zsh/wiki/Themes
ZSH_THEME="agkozak"

# Set list of themes to pick from when loading at random
# Setting this variable when ZSH_THEME=random will cause zsh to load
# a theme from this variable instead of looking in ~/.oh-my-zsh/themes/
# If set to an empty array, this variable will have no effect.
# ZSH_THEME_RANDOM_CANDIDATES=( "robbyrussell" "agnoster" )

# Uncomment the following line to use case-sensitive completion.
# CASE_SENSITIVE="true"

# Uncomment the following line to use hyphen-insensitive completion.
# Case-sensitive completion must be off. _ and - will be interchangeable.
# HYPHEN_INSENSITIVE="true"

# Uncomment the following line to disable bi-weekly auto-update checks.
# DISABLE_AUTO_UPDATE="true"

# Uncomment the following line to change how often to auto-update (in days).
# export UPDATE_ZSH_DAYS=13

# Uncomment the following line to disable colors in ls.
# DISABLE_LS_COLORS="true"

# Uncomment the following line to disable auto-setting terminal title.
# DISABLE_AUTO_TITLE="true"

# Uncomment the following line to enable command auto-correction.
# ENABLE_CORRECTION="true"

# Uncomment the following line to display red dots whilst waiting for completion.
# COMPLETION_WAITING_DOTS="true"

# Uncomment the following line if you want to disable marking untracked files
# under VCS as dirty. This makes repository status check for large repositories
# much, much faster.
# DISABLE_UNTRACKED_FILES_DIRTY="true"

# Uncomment the following line if you want to change the command execution time
# stamp shown in the history command output.
# You can set one of the optional three formats:
# "mm/dd/yyyy"|"dd.mm.yyyy"|"yyyy-mm-dd"
# or set a custom format using the strftime function format specifications,
# see 'man strftime' for details.
# HIST_STAMPS="mm/dd/yyyy"

# Would you like to use another custom folder than $ZSH/custom?
# ZSH_CUSTOM=/path/to/new-custom-folder

# Which plugins would you like to load?
# Standard plugins can be found in ~/.oh-my-zsh/plugins/*
# Custom plugins may be added to ~/.oh-my-zsh/custom/plugins/
# Example format: plugins=(rails git textmate ruby lighthouse)
# Add wisely, as too many plugins slow down shell startup.
plugins=(
  brew
  colored-man-pages
  git
  gitfast
  gitignore
  zoxide
  tig
)

# Allow device-specific plugins set before sourcing this file
if [[ -n "${DEVICE_PLUGINS[*]}" ]]; then
  plugins+=("${DEVICE_PLUGINS[@]}")
fi

# Custom zfuncs
fpath+=~/.zfunc

# Homebrew completions
if type brew &>/dev/null; then
  FPATH=$(brew --prefix)/share/zsh/site-functions:$FPATH
fi

# The TERM-fallback guard for hosts lacking the inherited terminfo entry lives in
# ~/.zshenv.shared, not here: ~/.zshrc runs terminfo-touching init (e.g. the bento
# remote's ~/.shellrc.d/004_devbox.sh) before this file is sourced, so the guard
# must run earlier -- from ~/.zshenv, before ~/.zshrc.

source $ZSH/oh-my-zsh.sh

# Ghostty auto-injects this only into direct child shells. Source it here so
# tmux-created shells keep prompt marks, title updates, and SSH helpers.
if [[ -n "${GHOSTTY_RESOURCES_DIR:-}" && -r "$GHOSTTY_RESOURCES_DIR/shell-integration/zsh/ghostty-integration" ]]; then
  source "$GHOSTTY_RESOURCES_DIR/shell-integration/zsh/ghostty-integration"
fi

# Ghostty opens a plain shell; tmux and herdr are launched on demand so the two
# multiplexers never nest and fight over the shared C-a prefix. `tm` reattaches
# or creates the persistent tmux session; herdr is started with `herdr`.

# User configuration

# Durable PATH setup belongs in login-shell environment files such as ~/.zprofile.

# You may need to manually set your language environment
# export LANG=en_US.UTF-8

# Preferred editor for local and remote sessions
# if [[ -n $SSH_CONNECTION ]]; then
#   export EDITOR='vim'
# else
#   export EDITOR='mvim'
# fi
export GIT_CEILING_DIRECTORIES=~
# TERM is negotiated by the terminal emulator, tmux, and SSH.
export EDITOR='nvim'

# Set personal aliases, overriding those provided by oh-my-zsh libs,
# plugins, and themes. Aliases can be placed here, though oh-my-zsh
# users are encouraged to define aliases within the ZSH_CUSTOM folder.
# For a full list of active aliases, run `alias`.
#
# Example aliases
# alias zshconfig="mate ~/.zshrc"
# alias ohmyzsh="mate ~/.oh-my-zsh"
alias vim='nvim'
# Attach to the persistent tmux session, creating it on first use.
alias tm='tmux new-session -A -s main'
alias zshconfig="vim ~/.zshrc"
alias brewski='bubu; brew doctor'

# https://remysharp.com/2018/08/23/cli-improved
# CLI improvements (conditionally defined based on tool availability)
if command -v ncdu &>/dev/null; then
  alias du="ncdu --color dark -rr -x --exclude .git --exclude node_modules"
fi
if command -v prettyping &>/dev/null; then
  alias ping='prettyping --nolegend'
fi
if command -v htop &>/dev/null; then
  alias top="htop"
fi

# eza/ls
if command -v eza &>/dev/null; then
  alias eza="eza --header --color-scale --time-style=long-iso --group-directories-first"
  alias ls=eza
fi

alias claudegood='claude --model claude-opus-4-8 --effort ultracode --dangerously-skip-permissions'
alias claudemax='claude --model claude-opus-4-8 --effort max --dangerously-skip-permissions'

# freshen — update every AI coding CLI plus oh-my-zsh and Homebrew in one pass.
# Each updater runs independently: a missing tool or a failing one never blocks
# the rest, and a pass/skip/fail summary prints at the end.
function freshen() {
  emulate -L zsh
  local -a summary

  _freshen_run() {  # <label> <probe-binary> <command-string>
    local label=$1 probe=$2 cmd=$3
    if ! command -v "$probe" &>/dev/null; then
      summary+=("  skip  $label (not installed)")
      return
    fi
    print -P "%F{cyan}%B==> $label%b%f"
    if eval "$cmd"; then
      summary+=("  ok    $label")
    else
      summary+=("  FAIL  $label")
    fi
  }

  _freshen_run claude    claude    'claude update'
  _freshen_run codex     codex     'codex update'
  _freshen_run pi        pi        'pi update'
  _freshen_run agy       agy       'agy update'
  _freshen_run opencode  opencode  'opencode upgrade'
  _freshen_run amp       amp       'amp update'
  # exe.dev intentionally omitted: it's a VM host reached via `ssh exe.dev`, not a
  # locally-installed CLI, so there is nothing here to self-update.
  _freshen_run omz       omz       'omz update'
  _freshen_run brew      brew      'brew update && brew upgrade && brew doctor'

  print -P "%F{cyan}%B==> summary%b%f"
  print -l -- "${summary[@]}"
  unfunction _freshen_run
}

######################################################################################
# FZF (git-based installation via ~/.fzf)
######################################################################################
[ -f ~/.fzf.zsh ] && source ~/.fzf.zsh

# https://remysharp.com/2018/08/23/cli-improved
alias preview="fzf --preview 'bat --color \"always\" {}'"

# add support for ctrl+o to open selected file in VS Code
export FZF_DEFAULT_OPTS="--bind='ctrl-o:execute(code {})+abort'"

# Use fd (https://github.com/sharkdp/fd) instead of the default find
# command for listing path candidates.
# - The first argument to the function ($1) is the base path to start traversal
# - See the source code (completion.{bash,zsh}) for the details.
_fzf_compgen_path() {
  fd --hidden --follow --exclude ".git" . "$1"
}

# Use fd to generate the list for directory completion
_fzf_compgen_dir() {
  fd --type d --hidden --follow --exclude ".git" . "$1"
}

# Follow symbolic links, and don't want it to exclude hidden files
export FZF_DEFAULT_COMMAND='fd --type f --hidden --follow --exclude .git'

# To apply the command to CTRL-T as well
export FZF_CTRL_T_COMMAND="$FZF_DEFAULT_COMMAND"

function branches () {
  local branch
  branch=$(git branch --sort=-committerdate |
    grep --invert-match '\*' |
    cut -c 3- |
    fzf --preview="git log {} | bat --style=plain --color=always --line-range :500")

  if [ -n "$branch" ]; then
    git checkout "$branch"
  fi
}

# from https://seb.jambor.dev/posts/improving-shell-workflows-with-fzf/

function delete-branches() {
  local branches
  branches=$(git branch |
    grep --invert-match '\*' |
    cut -c 3- |
    fzf --multi --preview="git log {} | bat --style=plain --color=always --line-range :500")

  if [ -n "$branches" ]; then
    echo "$branches" | while read -r branch; do
      git branch --delete --force "$branch"
    done
  fi
}

function pr-checkout() {
  local jq_template pr_number

  jq_template='"'\
'#\(.number) - \(.title)'\
'\t'\
'Author: \(.user.login)\n'\
'Created: \(.created_at)\n'\
'Updated: \(.updated_at)\n\n'\
'\(.body)'\
'"'

  pr_number=$(
    gh api --paginate 'repos/:owner/:repo/pulls' |
    jq ".[] | $jq_template" |
    sed -E -e 's/"(.*)"/\1/' -e $'s/\\\\t/\t/' |
    fzf \
      --with-nth=1 \
      --delimiter='\t' \
      --preview='echo -e {2} | bat --style=plain --color=always --line-range :500 -l markdown' \
      --preview-window=top:wrap |
    sed -E 's/^#([0-9]+).*/\1/'
  )

  if [ -n "$pr_number" ]; then
    gh pr checkout "$pr_number"
  fi
}

function activate-venv() {
  local selected_env
  selected_env=$(command ls ~/.venv/ 2>/dev/null | fzf)

  if [ -n "$selected_env" ]; then
    source "$HOME/.venv/$selected_env/bin/activate"
  fi
}

# By default, Ollama unloads models after 5 minutes of inactivity.
export OLLAMA_KEEP_ALIVE="-1"
