# Generic zsh configuration - sourced by device-specific .zshrc files
# vim: set filetype=zsh:

# Path to oh-my-zsh installation
export ZSH="$HOME/.oh-my-zsh"

# Theme
ZSH_THEME="agkozak"

# Plugins
plugins=(
  brew
  colored-man-pages
  git
  gitfast
  gitignore
  zoxide
  tig
)

# Allow device-specific plugins set before sourcing this file
if [[ -n "${DEVICE_PLUGINS[*]}" ]]; then
  plugins+=("${DEVICE_PLUGINS[@]}")
fi

# Custom zfuncs
fpath+=~/.zfunc

# Homebrew completions
if type brew &>/dev/null; then
  FPATH=$(brew --prefix)/share/zsh/site-functions:$FPATH
fi

source $ZSH/oh-my-zsh.sh

# Environment
export GIT_CEILING_DIRECTORIES=~
export TERM="xterm-256color"
export EDITOR='nvim'

# Aliases
alias vim='nvim'
alias zshconfig="vim ~/.zshrc"
alias brewski='bubu; brew doctor'

# FZF (git-based installation via ~/.fzf)
[ -f ~/.fzf.zsh ] && source ~/.fzf.zsh
alias preview="fzf --preview 'bat --color \"always\" {}'"
export FZF_DEFAULT_OPTS="--bind='ctrl-o:execute(code {})+abort'"

_fzf_compgen_path() {
  fd --hidden --follow --exclude ".git" . "$1"
}

_fzf_compgen_dir() {
  fd --type d --hidden --follow --exclude ".git" . "$1"
}

export FZF_DEFAULT_COMMAND='fd --type f --hidden --follow --exclude .git'
export FZF_CTRL_T_COMMAND="$FZF_DEFAULT_COMMAND"

# https://remysharp.com/2018/08/23/cli-improved
# CLI improvements (conditionally defined based on tool availability)
if command -v ncdu &>/dev/null; then
  alias du="ncdu --color dark -rr -x --exclude .git --exclude node_modules"
fi
if command -v prettyping &>/dev/null; then
  alias ping='prettyping --nolegend'
fi
if command -v htop &>/dev/null; then
  alias top="htop"
fi

# eza/ls
if command -v eza &>/dev/null; then
  alias eza="eza --header --color-scale --time-style=long-iso --group-directories-first"
  alias ls=eza
fi

# PATH
export PATH="$HOME/.local/bin:$PATH"
export PATH="$HOME/go/bin:$PATH"
export PATH="$HOME/.cargo/bin:$PATH"

######################################################################################
# FZF functions
######################################################################################
function branches () {
  local branch
  branch=$(git branch --sort=-committerdate |
    grep --invert-match '\*' |
    cut -c 3- |
    fzf --preview="git log {} | bat --style=plain --color=always --line-range :500")

  if [ -n "$branch" ]; then
    git checkout "$branch"
  fi
}

######################################################################################
# Python
######################################################################################

# from https://seb.jambor.dev/posts/improving-shell-workflows-with-fzf/
function activate-venv() {
  local selected_env
  selected_env=$(command ls ~/.venv/ 2>/dev/null | fzf)

  if [ -n "$selected_env" ]; then
    source "$HOME/.venv/$selected_env/bin/activate"
  fi
}

function delete-branches() {
  local branches
  branches=$(git branch |
    grep --invert-match '\*' |
    cut -c 3- |
    fzf --multi --preview="git log {} | bat --style=plain --color=always --line-range :500")

  if [ -n "$branches" ]; then
    echo "$branches" | while read -r branch; do
      git branch --delete --force "$branch"
    done
  fi
}

function pr-checkout() {
  local jq_template pr_number

  jq_template='"'\
'#\(.number) - \(.title)'\
'\t'\
'Author: \(.user.login)\n'\
'Created: \(.created_at)\n'\
'Updated: \(.updated_at)\n\n'\
'\(.body)'\
'"'

  pr_number=$(
    gh api --paginate 'repos/:owner/:repo/pulls' |
    jq ".[] | $jq_template" |
    sed -E -e 's/"(.*)"/\1/' -e $'s/\\\\t/\t/' |
    fzf \
      --with-nth=1 \
      --delimiter='\t' \
      --preview='echo -e {2} | bat --style=plain --color=always --line-range :500 -l markdown' \
      --preview-window=top:wrap |
    sed -E 's/^#([0-9]+).*/\1/'
  )

  if [ -n "$pr_number" ]; then
    gh pr checkout "$pr_number"
  fi
}
