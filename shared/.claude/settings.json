{
  "permissions": {
    "allow": [
      "*",
      "Bash",
      "Bash(claude mcp list)",
      "Read",
      "Write",
      "Edit",
      "Glob",
      "Grep",
      "Task",
      "TodoWrite",
      "WebFetch",
      "WebSearch",
      "NotebookEdit",
      "NotebookRead",
      "AskUserQuestion",
      "Skill",
      "SlashCommand",
      "BashOutput",
      "KillShell",
      "mcp__playwright__*",
      "mcp__chrome-devtools__*",
      "mcp__glean_default__search",
      "mcp__glean_default__chat",
      "mcp__glean_default__read_document",
      "mcp__private-journal__process_thoughts"
    ],
    "deny": [],
    "ask": ["Bash(git commit:*)", "Bash(git push:*)", "Bash(rm:*)"],
