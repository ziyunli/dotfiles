# Shared zsh environment, sourced from the machine-local ~/.zshenv (kept out of
# this repo so machine-local tooling can append its own setup there without
# churning these tracked dotfiles). Reaches every zsh invocation, including
# non-login, non-interactive shells (`zsh -c …`). Login/interactive PATH setup
# belongs in ~/.zprofile / ~/.zshrc; keep this one minimal.

# fzf's git-based install (~/.fzf) is added to PATH by ~/.fzf.zsh, which is
# sourced from ~/.zshrc, so only interactive shells receive it. The tmux alt-p
# file picker runs its `display-popup` body as `zsh -c`; without ~/.fzf/bin here
# that shell cannot find `fzf`, so the popup's command exits and it closes at
# once. The directory guard makes this a no-op where fzf is installed elsewhere.
if [[ -d "$HOME/.fzf/bin" && ":$PATH:" != *":$HOME/.fzf/bin:"* ]]; then
  export PATH="$HOME/.fzf/bin:$PATH"
fi

# opencode deep-merges the file named by OPENCODE_CONFIG over its global config.
# install.sh composes the personal overlay (superpowers everywhere, plus the work
# model on work devices) into ~/.config/opencode.personal.json -- a sibling of the
# company-tool-managed ~/.config/opencode/ dir, which never sees it. The file
# guard only skips machines where the overlay was never installed (there
# .zshenv.shared is not sourced anyway).
if [[ -f "$HOME/.config/opencode.personal.json" ]]; then
  export OPENCODE_CONFIG="$HOME/.config/opencode.personal.json"
fi

# Fall back to a widely available terminfo entry when the inherited TERM has no
# definition on this host. Ghostty advertises rich values like xterm-ghostty and
# installs the matching terminfo on remotes through its own SSH wrapper; paths
# that bypass that wrapper -- e.g. `bento remote ssh` -- forward xterm-ghostty to
# hosts without the entry, so every terminfo lookup during startup fails. This
# lives in ~/.zshenv (sourced before ~/.zshrc) rather than in ~/.zshrc.common
# because ~/.zshrc sources terminfo-touching init before the interactive config:
# on the bento remote, ~/.shellrc.d/004_devbox.sh runs devbox's shellenv before
# ~/.shellrc.d/005 sources ~/.zshrc.common, so a guard there runs one file too
# late. Gated to interactive shells so non-interactive `zsh -c` never forks infocmp.
if [[ -o interactive && -n "${TERM:-}" ]] && ! infocmp "$TERM" &>/dev/null; then
  export TERM=xterm-256color
fi
