# macOS login-shell environment shared by personal Apple devices.

# Homebrew must be on PATH before interactive zsh loads shared completions.
if [[ -x /opt/homebrew/bin/brew ]]; then
  eval "$(/opt/homebrew/bin/brew shellenv)"
fi

# Login-shell environment inherited by child processes.
typeset -U path
path=(
  "$HOME/.local/bin"
  "$HOME/.opencode/bin"
  "$HOME/bin"
  "$HOME/go/bin"
  "$HOME/.cargo/bin"
  $path
)
export PATH

# GBrain uses a bearer token; keep the secret in Keychain and expose it to Codex.
if command -v security >/dev/null 2>&1; then
  if gbrain_remote_token="$(security find-generic-password -a "$USER" -s gbrain-remote-token -w 2>/dev/null)" &&
    [[ -n "$gbrain_remote_token" ]]; then
    export GBRAIN_REMOTE_TOKEN="$gbrain_remote_token"
  fi
  unset gbrain_remote_token
fi
