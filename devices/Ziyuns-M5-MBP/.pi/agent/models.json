            "minimal": null,
            "low": null,
            "medium": null,
            "high": null,
            "xhigh": null,
            "max": "max"
          },
          "input": [
            "text"
          ],
          "contextWindow": 32768,
          "maxTokens": 16384,
          "cost": {
            "input": 0,
            "output": 0,
            "cacheRead": 0,
            "cacheWrite": 0
          }
        }
      ]
    }
  }
}
