[include]
	path = ~/.gitconfig.local
[core]
	whitespace = trailing-space,space-before-tab
	pager = delta
	excludesFile = ~/.gitignore_global
[push]
	default = current
[fetch]
	prune = true
[credential]
	helper = osxkeychain
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
[diff]
	mnemonicprefix = true
	colorMoved = zebra
[merge]
	stat = true
	conflictstyle = diff3
[pull]
	ff = only
	rebase = true
[branch]
	autosetupmerge = true
[delta]
	plus-color = "#012800"
	minus-color = "#340001"
	syntax-theme = Monokai Extended
	navigate = true  # use n and N to move between diff sections
	light = false
	line-numbers = true
	side-by-side = true
[interactive]
	diffFilter = delta --color-only
[init]
	defaultBranch = main
