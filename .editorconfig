# EditorConfig helps maintain consistent coding styles across editors
# https://editorconfig.org

root = true

# Defaults for all files
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

# Shell scripts
[*.{sh,bash,zsh}]
indent_style = space
indent_size = 2

# Shared zsh config (no standard extension)
[shared/.zshrc.common]
indent_style = space
indent_size = 2

# Git config files
[{.gitconfig,.gitconfig.local,.gitconfig.local.example}]
indent_style = tab

# Markdown
[*.md]
indent_style = space
indent_size = 2
trim_trailing_whitespace = false

# YAML
[*.{yml,yaml}]
indent_style = space
indent_size = 2

# JSON
[*.json]
indent_style = space
indent_size = 2
